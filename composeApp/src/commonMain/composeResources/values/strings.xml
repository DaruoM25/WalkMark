    <string name="faq_getting_started_question">How do I get started?</string>
    <string name="faq_getting_started_answer">WalkMark is a private, local-first walk journal. Start a walk from the main screen and stop it when you finish.</string>
    <string name="faq_start_stop_question">How do I start or stop a walk?</string>
    <string name="faq_start_stop_answer">Use Start Walk on the main screen. While recording, use Stop Walk to end the active recording.</string>
    <string name="faq_location_permission_question">Why does WalkMark request location permission?</string>
    <string name="faq_location_permission_answer">Location permission is required to record your route during an active walk. Grant the permission from the visible Start Walk action.</string>
    <string name="faq_gps_question">What should I do if GPS tracking is unavailable?</string>
    <string name="faq_gps_answer">Confirm that device location is enabled and WalkMark has location permission. Then return to the main screen and try starting the walk again.</string>
    <string name="faq_privacy_question">Where is my walk information stored?</string>
    <string name="faq_privacy_answer">Walk data is stored locally on your device. WalkMark does not silently upload routes, locations, notes, photos, logs, or diagnostics.</string>
    <string name="faq_contact_question">How do I contact support?</string>
    <string name="faq_contact_answer">If a support email is configured for this build, use Contact support by email. You review and send the message in your email application.</string>
